# Backend Environment Variables

# Server
PORT=3001
NODE_ENV=development

# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI Services (ALL FREE - Priority Order)
# 1. Google Gemini (Primary - Best quality)
GEMINI_API_KEY=your_google_gemini_api_key

# 2. OpenAI GPT-4o-mini (High quality, cost-effective)
OPENAI_API_KEY=your_openai_api_key

# 3. Groq (Backup - Fastest)
GROQ_API_KEY=your_groq_api_key

# 4. Claude (Anthropic - High quality)
CLAUDE_API_KEY=your_claude_api_key

# 5. Mistral AI (High Capacity - 1B tokens/month)
MISTRAL_API_KEY=your_mistral_api_key

# 6. OpenRouter (Multiple free models with rotation)
OPENROUTER_API_KEY=your_openrouter_api_key

# 7.# Cloudflare Workers AI (Optional fallback #3)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Admin Access
ADMIN_EMAIL=your_admin_email@example.com

# 8. Cohere (Good for chat)
COHERE_API_KEY=your_cohere_api_key

# 9. Hugging Face (Open source models)
HUGGINGFACE_API_KEY=your_huggingface_api_key

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# Firebase Cloud Messaging (for Android push notifications)
# Use either raw JSON or base64 JSON. Base64 is recommended on Render/production.
FIREBASE_SERVICE_ACCOUNT_BASE64=base64_encoded_firebase_admin_service_account_json
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Stripe (for payments)
PAYMENTS_PROVIDER=google_play
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.asmind.app
GOOGLE_PLAY_PACKAGE_NAME=com.asmind.app
GOOGLE_PLAY_MONTHLY_PRODUCT_ID=premium_monthly
GOOGLE_PLAY_YEARLY_PRODUCT_ID=premium_yearly
# Use one of these for server-side Play purchase verification.
GOOGLE_PLAY_SERVICE_ACCOUNT_BASE64=base64_encoded_service_account_json
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}
# Set PAYMENTS_PROVIDER=stripe only if web checkout is re-enabled later.
# STRIPE_SECRET_KEY=your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
