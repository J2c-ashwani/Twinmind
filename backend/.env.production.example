# Server Configuration
PORT=5001
NODE_ENV=production

# Security (CRITICAL)
# Generate a strong random string (e.g., `openssl rand -hex 32`)
JWT_SECRET=

# Supabase Configuration (Get from Supabase Dashboard)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider Keys (At least one required)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
HUGGINGFACE_API_KEY=
OPENROUTER_API_KEY=

# Cloudflare Workers AI (Optional but recommended for fallback)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Firebase Cloud Messaging (Android push notifications)
FIREBASE_SERVICE_ACCOUNT_BASE64=
# FIREBASE_SERVICE_ACCOUNT=

# Payment Gateway (Razorpay)
PAYMENTS_PROVIDER=google_play
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.asmind.app
GOOGLE_PLAY_PACKAGE_NAME=com.asmind.app
GOOGLE_PLAY_MONTHLY_PRODUCT_ID=premium_monthly
GOOGLE_PLAY_YEARLY_PRODUCT_ID=premium_yearly
# Use one of these for server-side Play purchase verification.
GOOGLE_PLAY_SERVICE_ACCOUNT_BASE64=
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# CORS Configuration
# Comma-separated list of allowed origins (e.g., https://your-app.vercel.app,https://your-mobile-app.web.app)
ALLOWED_ORIGINS=
